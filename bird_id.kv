#:import dp kivy.metrics.dp

<BirdRoot>:
    orientation: 'vertical'
    padding: dp(8)
    spacing: dp(8)

    Camera:
        id: camera
        play: True
        resolution: (1280, 720)

    Label:
        text: root.status
        halign: 'center'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: dp(96)

    Button:
        text: 'Identify bird'
        size_hint_y: None
        height: dp(56)
        on_release: root.identify()
